# Lido por `uv run uvicorn` e pelo docker-compose (`env_file`).
# Copie para `.env` e ajuste.

# Sem token, qualquer um escreve. Bom na máquina, ruim na internet.
CACHE_WRITE_TOKEN=

# Fora do Docker o padrão é sqlite:///./cache.db, ao lado do processo.
#
# No docker-compose o volume monta em /data. Sem o caminho abaixo
# o banco morre no rebuild.
#
#   DATABASE_URL=sqlite:////data/cache.db
DATABASE_URL=

# GET /recomendacoes. Padrão 60/minute.
RATE_LIMIT_LEITURA=

# POST /recomendacoes. Padrão 10/minute.
RATE_LIMIT_ESCRITA=
