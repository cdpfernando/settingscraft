# Este mesmo arquivo .env e lido tanto por `uv run uvicorn` (local, fora de
# container) quanto pelo docker-compose (via `env_file` em api/docker-compose.yml).
# Copie este arquivo para `.env` e ajuste os valores conforme o fluxo que for usar.

# Token exigido no cabecalho X-Cache-Token para escrever no cache.
# Ausente/vazio: escrita fica aberta (desenvolvimento local).
CACHE_WRITE_TOKEN=

# Opcional. Padrao quando ausente: sqlite:///./cache.db — usado por
# `uv run uvicorn` local (arquivo relativo ao processo, fora de container).
#
# Rodando via docker-compose, defina EXPLICITAMENTE o valor abaixo: o volume
# nomeado do docker-compose.yml e montado em /data dentro do container, e so
# um caminho dentro dele sobrevive a `docker-compose down`/`up` e a rebuilds.
# Sem isso, o SQLite fica dentro do container e se perde a cada rebuild.
#
#   DATABASE_URL=sqlite:////data/cache.db
DATABASE_URL=

# Limite de requisicoes por IP para GET /recomendacoes (leitura).
# Opcional. Padrao: 60/minute
RATE_LIMIT_LEITURA=

# Limite de requisicoes por IP para POST /recomendacoes (escrita).
# Opcional. Padrao: 10/minute
RATE_LIMIT_ESCRITA=
